{
  "manifest_version": 3,
  "name": "Anti Brainrot",
  "version": "1.8.0",
  "description": "Feeds, Shorts and distracting sites behind a friction timer. Blocks or pauses sites, locks itself in focus hours, hard to remove.",
  "key": "",
  "minimum_chrome_version": "111",
  "author": "danieltyukov",
  "homepage_url": "https://github.com/danieltyukov/anti-brainrot",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Anti Brainrot",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://youtube.com/*"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "shorts",
        "enabled": true,
        "path": "rules/shorts.json"
      },
      {
        "id": "adult",
        "enabled": false,
        "path": "rules/adult.json"
      },
      {
        "id": "safesearch",
        "enabled": false,
        "path": "rules/safesearch.json"
      },
      {
        "id": "youtube-restrict",
        "enabled": false,
        "path": "rules/youtube-restrict.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "css": [
        "content/hide.css"
      ],
      "js": [
        "lib/features.js",
        "lib/settings.js",
        "lib/shorts.js",
        "lib/education.js",
        "lib/keywords.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked/blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
