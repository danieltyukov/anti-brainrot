{
  "manifest_version": 3,
  "name": "Anti-Brainrot",
  "version": "0.1.0",
  "description": "YouTube without the brain rot. Blocks Shorts for good, hides feeds and distractions behind a friction timer, and can limit playback to educational videos.",
  "key": "",
  "minimum_chrome_version": "111",
  "author": "danieltyukov",
  "homepage_url": "https://github.com/danieltyukov/anti-brainrot",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Anti-Brainrot",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://youtube.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "shorts",
        "enabled": true,
        "path": "rules/shorts.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "css": [
        "content/hide.css"
      ],
      "js": [
        "lib/features.js",
        "lib/settings.js",
        "lib/shorts.js",
        "lib/education.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
